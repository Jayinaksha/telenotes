# Copy to .env for local runs. On Render these go in the service's
# Environment tab instead. Never commit a filled-in copy.

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=123456:ABC-DEF...                      # from @BotFather
WEBHOOK_URL=https://your-service.onrender.com    # public URL of THIS service
WEBHOOK_SECRET=change-me-to-a-long-random-string # sent to Telegram, checked on every delivery
PORT=8080                                        # Render sets this; leave unset there

# Telegram chat ids allowed to use the bot, comma-separated. Leave empty and
# ANY stranger who finds the bot can write into your vault and burn your
# storage quota. Message the bot once and it replies with your chat id.
ALLOWED_CHAT_IDS=123456789

# --- Supabase (Postgres: metadata + full-text search) -----------------------
# Project Settings -> Database -> Connection string -> "Session pooler".
# The pooler copes with a free Render instance sleeping and waking; a direct
# connection does not.
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- GitHub vault (notes as markdown, and files when R2 is off) -------------
# Fine-grained PAT scoped to ONE private repo with "Contents: Read and write".
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=telenotes-vault
GITHUB_BRANCH=main

# --- Cloudflare R2 (optional: binary files) ---------------------------------
# All four or none. Unset entirely and files land in the GitHub vault instead.
# Free tier: 10GB stored, 1M writes/mo, 10M reads/mo, zero egress charges.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Notion (optional: one-way mirror) --------------------------------------
# Both or neither. See SETUP.md for the properties the database needs.
NOTION_TOKEN=
NOTION_DATABASE_ID=
